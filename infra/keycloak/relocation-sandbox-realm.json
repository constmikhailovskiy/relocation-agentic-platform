{
  "realm": "relocation-sandbox",
  "enabled": true,
  "registrationAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "new_hire"
      },
      {
        "name": "relocation_manager"
      },
      {
        "name": "hiring_manager"
      },
      {
        "name": "agent_builder"
      },
      {
        "name": "auditor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "relocation-cli",
      "name": "Relocation CLI (pnpm chat)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-relocation-cli",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "relocation-cli",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-mcp-relocation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-relocation",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
