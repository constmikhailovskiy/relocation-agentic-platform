# Скопіюй у .env:  cp .env.example .env
# .env у .gitignore — справжні ключі в git не потрапляють.

PORT=8787
DB_PATH=data/gateway.db

# Ключ Anthropic з окремого workspace в Claude Console (з лімітом $20).
# Без нього haiku/sonnet відповідатимуть помилкою, а mock і Ollama працюватимуть.
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# Дозволені країни походження моделей (ISO-коди). Усе інше gateway відхилить з 403.
ALLOWED_MODEL_ORIGINS=US,FR,GB,DE,UA

# Клієнти gateway. У конфігу лише sha256 ключа; сам ключ знає тільки клієнт.
# Dev-ключі: "dev-runtime-key" і "dev-evals-key". Нові ключі: pnpm gateway:key <name>
GATEWAY_CLIENTS=[{"name":"runtime","keySha256":"1ddc00ec8b7ecdf81930629e60ac407797e05cd051592c0857062d2a939d536a","models":["haiku","sonnet","gpt-oss","mistral-small","mock","mock-backup"],"dailyBudgetUsd":5,"maxRunUsd":0.2},{"name":"evals","keySha256":"dda3490f43675e4b441a39cb69ea46f799ca39e9944262f086f90a47cf229d7c","models":["haiku","sonnet","gpt-oss","mock","mock-backup"],"dailyBudgetUsd":3,"maxRunUsd":0.5}]

# Хаос-перемикач для симуляції інцидентів: anthropic | ollama | mock | <alias моделі>
# FAIL_PROVIDER=anthropic

UPSTREAM_TIMEOUT_MS=60000
