# Скопіюй у .env:  cp .env.example .env
# .env у .gitignore — справжні ключі в git не потрапляють.

PORT=8787
DB_PATH=data/gateway.db

# Ключ Anthropic з окремого workspace в Claude Console (з лімітом $20).
# Без нього haiku/sonnet відповідатимуть помилкою, а mock і Ollama працюватимуть.
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# Дозволені країни походження моделей (ISO-коди). Усе інше gateway відхилить з 403.
ALLOWED_MODEL_ORIGINS=US,FR,GB,DE,UA

# Клієнти gateway. У конфігу лише sha256 ключа; сам ключ знає тільки клієнт.
# Dev-ключі: "dev-runtime-key" і "dev-evals-key". Нові ключі: pnpm gateway:key <name>
GATEWAY_CLIENTS=[{"name":"runtime","keySha256":"1ddc00ec8b7ecdf81930629e60ac407797e05cd051592c0857062d2a939d536a","models":["haiku","sonnet","gpt-oss","mistral-small","mock","mock-backup"],"dailyBudgetUsd":5,"maxRunUsd":0.2},{"name":"evals","keySha256":"dda3490f43675e4b441a39cb69ea46f799ca39e9944262f086f90a47cf229d7c","models":["haiku","sonnet","gpt-oss","mock","mock-backup"],"dailyBudgetUsd":3,"maxRunUsd":0.5}]

# Хаос-перемикач для симуляції інцидентів: anthropic | ollama | mock | <alias моделі>
# FAIL_PROVIDER=anthropic

UPSTREAM_TIMEOUT_MS=60000

# --- MCP-сервер listings (pnpm listings) ---
LISTINGS_PORT=8788
# Хаос для check_availability: частка відповідей 429 (0..1) і затримка, мс. Ранбук: 0.5 і 4000.
LISTINGS_429_RATE=0
LISTINGS_LATENCY_MS=0
# Зафіксувати «зараз» для демо на фікстурах (ISO). Порожньо або закоментовано — справжній годинник.
# LISTINGS_NOW=2026-11-15T09:00:00.000Z

# --- MCP-сервер relocation (pnpm relocation) ---
RELOCATION_PORT=8789
# Зафіксувати «зараз» (ISO): слоти request_viewing мають бути в майбутньому відносно нього.
# RELOCATION_NOW=2026-11-15T09:00:00.000Z

# --- Agent runtime (pnpm chat --as olena) ---
# Ключ клієнта gateway "runtime" (dev). Не ключ Anthropic: його runtime не має.
RUNTIME_GATEWAY_KEY=dev-runtime-key
# GATEWAY_URL=http://127.0.0.1:8787
# LISTINGS_URL=http://127.0.0.1:8788/mcp
# RELOCATION_URL=http://127.0.0.1:8789/mcp
# «Зараз» для системного промпту; для демо на фікстурах — той самий, що LISTINGS_NOW і RELOCATION_NOW.
# RUNTIME_NOW=2026-11-15T09:00:00.000Z

# --- Етап 4: автентифікація ---
# jwt (за замовчуванням) | debug — заглушка x-debug-* для MCP Inspector (усі процеси мають бути в одному режимі)
# AUTH_MODE=jwt
# IDP_ISSUER=http://127.0.0.1:8080/realms/relocation-sandbox
# RUNTIME_JWKS_PATH=.secrets/runtime-sts.jwks.json
# RUNTIME_STS_KEY_PATH=.secrets/runtime-sts.private.jwk.json
# Спільний журнал аудиту обох MCP-серверів (відносний — від кореня репо)
# AUDIT_DB_PATH=data/audit.db
# Пароль демо-людей у Keycloak-пісочниці (для неінтерактивного pnpm chat). Не секрет.
# DEMO_PASSWORD=sandbox
